<li class="chat-list-item">
  <div class="avatar-container">
    {{{Avatar avatar=chatItem.avatar size="47px" }}}
  </div>
  <div class="content">
    <h3 class="name">{{ chatItem.name }}</h3>
    <p class="last-message">{{ chatItem.last_message }}</p>
  </div>
  <div class="status">
    <span class="time">{{ chatItem.time }}</span>
    <span class="label"></span>
  </div>
</li>
