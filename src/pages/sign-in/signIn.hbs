<main class="sign-in">
  <div class="container">
    <h1 class="title">Вход</h1>
    <form class="form">
      {{{Field name="login" textLabel="Логин"}}}
      {{{Field name="password" type="password" autocomplete="on" textLabel="Пароль"}}}
      {{{Button type="submit" className="button" style="primary" text="Авторизоваться"}}}
    </form>
    <a class="link" href="/sign-up">Зарегистрироваться</a>
  </div>
</main>
