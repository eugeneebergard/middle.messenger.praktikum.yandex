<main class="sign-up">
  <div class="container">
    <h1 class="title">Регистрация</h1>
    <form class="form">
      {{{Field name="email" type="email" textLabel="Электронная почта"}}}
      <div class="grid-container">
        {{{Field name="first_name" textLabel="Имя"}}}
        {{{Field name="second_name" textLabel="Фамилия"}}}
        {{{Field name="login" textLabel="Логин"}}}
        {{{Field name="phone" type="number" textLabel="Номер телефона"}}}
        {{{Field name="password" type="password" autocomplete="on" textLabel="Пароль"}}}
        {{{Field name="repeatPassword" type="password" autocomplete="on" textLabel="Повторите пароль"}}}
      </div>
      {{{Button type="submit" className="button" style="primary" text="Зарегестрироваться"}}}
    </form>
    <a class="link" href="/sign-in">Войти</a>
  </div>
</main>
