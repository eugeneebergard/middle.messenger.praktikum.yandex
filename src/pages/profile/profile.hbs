<main class="profile">
  <aside class="aside">
    <a class="back" href="/" title="Назад к чатам"></a>
  </aside>
  <div class="content">
    <div class="container">
      <div class="heading">
        {{{Avatar avatar=userData.avatar size="130px"}}}
        <input class="file-upload hidden" name="avatar" type="file" accept="image/*"/>
        <h3 class="name-title">{{ userData.name }}</h3>
      </div>

      <form class="info-form">
        <div class="grid-container">
          {{{Field name="email" type="email" value=userData.email required="true" disabled="true" textLabel="Электронная почта"}}}
          {{{Field name="login" value=userData.login required="true" disabled="true" textLabel="Логин"}}}
          {{{Field name="first_name" value=userData.first_name required="true" disabled="true" textLabel="Имя"}}}
          {{{Field name="second_name" value=userData.second_name required="true" disabled="true" textLabel="Фамилия"}}}
          {{{Field name="display_name" value=userData.display_name required="true" disabled="true" textLabel="Никнейм"}}}
          {{{Field name="phone" value=userData.phone required="true" disabled="true" textLabel="Номер телефона"}}}
        </div>

        {{{Button type="submit" className="submit hidden" style="primary" text="Сохранить"}}}
      </form>

      <div class="controls">
        {{{Button className="button edit-info" style="primary-link" text="Изменить данные"}}}
        {{{Button className="button edit-password" style="primary-link" text="Изменить пароль"}}}
        {{{Button className="button logout" style="danger-link" text="Выйти"}}}
      </div>

      <form class="password-form hidden">
        {{{Field name="oldPassword" type="password" autocomplete="on" textLabel="Пароль" required="true"}}}
        {{{Field name="newPassword" type="password" autocomplete="on" textLabel="Новый пароль" required="true"}}}
        {{{Field name="repeatPassword" type="password" autocomplete="on" textLabel="Повторите пароль" required="true"}}}
        {{{Button type="submit" className="submit" style="primary" text="Сохранить"}}}
      </form>
    </div>
  </div>
</main>
